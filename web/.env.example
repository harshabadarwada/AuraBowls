# Local SQLite. Production should use managed PostgreSQL — see docs/POSTGRES.md
DATABASE_URL="file:./dev.db"

# Long random string. Signs admin sessions, OTP hashes, and the dev payment simulator.
APP_SECRET="replace-with-a-long-random-string"

# Created on first seed. Change before any shared or deployed use.
ADMIN_EMAIL="admin@aurabowls.local"
ADMIN_PASSWORD="change-me-local-only"

# Local only. Never enable these in production.
OTP_DEV_REVEAL="true"
PAYMENT_SIMULATOR="true"

# Public site. Production is https://theaurabowl.com. Leave the local value for this machine.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Kitchen WhatsApp, digits only, with country code. Menu orders open a draft to this number.
ORDER_WHATSAPP=""
BUSINESS_TIMEZONE="Asia/Kolkata"

# Razorpay. The key id is public. The secret and webhook secret stay on the server.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_WEBHOOK_SECRET=""

# WhatsApp Cloud API. OTP uses the template. The 12-hour meal check uses WHATSAPP_MEAL_CHECK_TEMPLATE when set, otherwise a text message.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OTP_TEMPLATE="aurabowls_otp"
WHATSAPP_MEAL_CHECK_TEMPLATE=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Protects POST /api/jobs/meal-check. Run it at least every 15 minutes.
CRON_SECRET=""

# SMS fallback. POST JSON { to, message } to SMS_API_URL with Authorization: Bearer SMS_API_KEY.
SMS_API_URL=""
SMS_API_KEY=""

# One-way export from the database to Google Sheets. The sheet is not a source of truth.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_SHEETS_SPREADSHEET_ID=""
